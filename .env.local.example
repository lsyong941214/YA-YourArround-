# 이 파일을 .env.local 로 복사한 뒤, Supabase 프로젝트(Project Settings > API)에서
# 값을 채워주세요. .env.local 은 .gitignore 에 이미 포함되어 커밋되지 않습니다.
# anon key는 브라우저에 노출돼도 되는 공개 키입니다 (RLS로 접근을 제어) -- service_role
# 키는 이 프로젝트에서 절대 쓰지 않습니다.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
